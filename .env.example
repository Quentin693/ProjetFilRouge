# Copier vers .env à la racine et adapter l'IP Wi‑Fi du Mac :
#   ipconfig getifaddr en0
#   cp .env.example .env

NEXT_PUBLIC_APP_URL=http://192.168.X.X:3000
AUTH_URL=http://192.168.X.X:3000
AUTH_SECRET=change-moi-en-production-minimum-32chars

# Optionnel — Unsplash
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
